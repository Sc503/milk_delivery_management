<!--            android:name="com.google.android.geo.API_KEY"-->
<!--            android:value="AIzaSyDNsl0MU5SRmeA6ORMknMDFe2ZIpyh_VBI" />-->


        <meta-data
                    android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCCu1yvuGwg0RzR5wHbdx1VmcDvdI-QnnA" />




                <meta-data
                    android:name="com.google.android.gms.version"
                    android:value="@integer/google_play_services_version" />

                <provider
                    android:name="androidx.core.content.FileProvider"
                    android:authorities="${applicationId}.provider"
                    android:exported="false"
                    android:grantUriPermissions="true">
                    <meta-data
                        android:name="android.support.FILE_PROVIDER_PATHS"
                        android:resource="@xml/file_paths" />
                </provider> <!-- Login Screen -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Main Screen -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkDelivery" /> <!-- Calendar Screen -->
        <activity
            android:name=".activities.CustomerCalendarActivity"
            android:exported="false"
            android:label="Customer Calendar"
            android:theme="@style/Theme.MilkDelivery" /> <!-- Recap Screen -->
        <activity
            android:name=".activities.CustomerRecapDetailsActivity"
            android:exported="false"
            android:label="Milk Delivery Summary"
            android:theme="@style/Theme.MilkDelivery" />
        <activity
            android:name=".activities.MyBackupsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.BackupCenterActivity"
            android:exported="false" />
        <activity
            android:name=".activities.WifiDirectActivity"
            android:exported="false" />
    </application>

</manifest>