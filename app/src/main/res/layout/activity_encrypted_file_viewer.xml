<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔒 Encrypted File"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A2332"
            android:ellipsize="middle"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvFileInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Size: Unknown"
            android:textSize="13sp"
            android:textColor="#7B8794"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Password Input Section -->
    <LinearLayout
        android:id="@+id/layoutPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:elevation="4dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔐 Enter Password to Decrypt"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A2332"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This file is encrypted. Enter the password to view its content."
            android:textSize="13sp"
            android:textColor="#7B8794"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter encryption password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:background="@drawable/edit_text_background"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDecrypt"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="🔓 Decrypt"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="10dp"
                app:backgroundTint="#3B82F6" />

            <!-- ✅ NEW: Restore Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestore"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="♻️ Restore"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="10dp"
                app:backgroundTint="#8B5CF6" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Tap 'Restore' to restore this backup directly"
            android:textSize="12sp"
            android:textColor="#7B8794"
            android:gravity="center"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- Decrypted Content Section -->
    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📄 Decrypted Content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A2332"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="12dp">

            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:background="#FFFFFF">

                <TextView
                    android:id="@+id/tvContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="#1A2332"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp" />

            </ScrollView>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- ✅ NEW: Restore button when content is visible -->
    <LinearLayout
        android:id="@+id/layoutRestoreButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestoreContent"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="♻️ Restore This Backup"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="10dp"
            app:backgroundTint="#8B5CF6"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseContent"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="✕ Close"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="10dp"
            app:backgroundTint="#EF4444"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Original Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="📤 Share"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="10dp"
            app:backgroundTint="#10B981"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="✕ Close"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="10dp"
            app:backgroundTint="#EF4444"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>