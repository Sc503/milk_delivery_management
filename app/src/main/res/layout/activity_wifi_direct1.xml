<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/gradient_background">

    <!-- Header Section -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/wifi_card_margin"
        app:cardCornerRadius="@dimen/wifi_card_corner"
        app:cardElevation="@dimen/wifi_card_elevation"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/wifi_card_padding">

            <!-- App Icon and Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/wifi_margin_medium">

                <LinearLayout
                    android:layout_width="@dimen/wifi_icon_size"
                    android:layout_height="@dimen/wifi_icon_size"
                    android:background="@drawable/icon_background"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📶"
                        android:textSize="@dimen/wifi_icon_text_size" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/wifi_margin_small">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WiFi Direct"
                        android:textSize="@dimen/wifi_title_size"
                        android:textStyle="bold"
                        android:textColor="#1A2332" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Send &amp; Receive Files"
                        android:textSize="@dimen/wifi_subtitle_size"
                        android:textColor="#7B8794" />
                </LinearLayout>

                <!-- Status Indicator -->
                <View
                    android:id="@+id/statusIndicator"
                    android:layout_width="@dimen/wifi_indicator_size"
                    android:layout_height="@dimen/wifi_indicator_size"
                    android:background="@drawable/status_indicator_off" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8ECF1"
                android:layout_marginVertical="@dimen/wifi_margin_small" />

            <!-- Connection Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/status_background"
                android:padding="@dimen/wifi_status_padding"
                android:layout_marginBottom="@dimen/wifi_margin_medium">

                <TextView
                    android:id="@+id/txtConnectionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="● Not Connected"
                    android:textStyle="bold"
                    android:textSize="@dimen/wifi_status_text_size"
                    android:textColor="#64748B"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtStatusHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tap 'Scan' to discover nearby devices"
                    android:textSize="@dimen/wifi_hint_text_size"
                    android:textColor="#94A3B8"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/wifi_margin_tiny" />
            </LinearLayout>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/wifi_margin_tiny">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScan"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/wifi_button_height"
                    android:layout_weight="1"
                    android:text="Scan Devices"
                    android:textAllCaps="false"
                    android:textSize="@dimen/wifi_button_text_size"
                    app:icon="@drawable/ic_scan"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/wifi_icon_padding"
                    app:cornerRadius="@dimen/wifi_button_corner"
                    app:backgroundTint="#3B82F6"
                    android:fontFamily="sans-serif-medium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDisconnect"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/wifi_button_height"
                    android:layout_weight="1"
                    android:text="Disconnect"
                    android:textAllCaps="false"
                    android:textSize="@dimen/wifi_button_text_size"
                    app:icon="@drawable/ic_disconnect"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/wifi_icon_padding"
                    app:cornerRadius="@dimen/wifi_button_corner"
                    app:backgroundTint="#EF4444"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="@dimen/wifi_button_margin" />
            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/wifi_progress_height"
                android:layout_marginTop="@dimen/wifi_margin_small"
                android:visibility="gone"
                android:progressTint="#10B981" />

            <!-- Send File Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendFile"
                android:layout_width="match_parent"
                android:layout_height="@dimen/wifi_button_height"
                android:layout_marginTop="@dimen/wifi_margin_small"
                android:text="📤 Select and Send File"
                android:textAllCaps="false"
                android:textSize="@dimen/wifi_button_text_size"
                app:cornerRadius="@dimen/wifi_button_corner"
                app:backgroundTint="#10B981"
                android:enabled="false"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Device List Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/wifi_card_margin"
        android:layout_marginBottom="@dimen/wifi_card_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/wifi_margin_medium">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Available Devices"
                android:textSize="@dimen/wifi_list_title_size"
                android:textStyle="bold"
                android:textColor="#1A2332"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/txtDeviceCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 found"
                android:textSize="@dimen/wifi_count_text_size"
                android:textColor="#7B8794"
                android:background="@drawable/count_badge"
                android:paddingHorizontal="@dimen/wifi_count_padding_h"
                android:paddingVertical="@dimen/wifi_count_padding_v" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="@dimen/wifi_list_corner"
            app:cardElevation="@dimen/wifi_card_elevation"
            app:cardBackgroundColor="#FFFFFF">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDevices"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/wifi_list_padding"
                android:clipToPadding="false"
                android:scrollbars="vertical" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No devices found\nTap 'Scan Devices' to discover"
            android:textSize="@dimen/wifi_empty_text_size"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:padding="@dimen/wifi_empty_padding"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>