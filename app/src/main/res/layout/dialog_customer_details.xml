<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- NAME -->
        <TextView
            android:id="@+id/dialog_txt_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="John Doe"
            android:textColor="@color/on_surface"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:background="@color/gray_light"/>

        <!-- MOBILE LABEL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mobile Number"
            android:textColor="@color/gray_dark"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/dialog_txt_mobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="9876543210"
            android:textColor="@color/on_surface"
            android:textSize="16sp"/>

        <!-- ADDRESS LABEL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Address"
            android:textColor="@color/gray_dark"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/dialog_txt_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Customer Address"
            android:textColor="@color/on_surface"
            android:textSize="16sp"/>

        <!-- CALL & NAVIGATE BUTTONS IN A ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_btn_call"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="📞 Call"
                android:textAllCaps="false"
                app:iconGravity="textStart"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_btn_navigate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="🗺 Navigate"
                android:textAllCaps="false"
                app:iconGravity="textStart"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp"/>

            <!-- ✅ NEW: EDIT BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_btn_edit"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="✏️ Edit"
                android:textAllCaps="false"
                app:iconGravity="textStart"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp"/>

        </LinearLayout>

        <!-- DELIVER BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_btn_deliver"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/primary"
            android:text="Mark Delivered"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"/>

        <!-- CANCEL -->
        <TextView
            android:id="@+id/dialog_btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:padding="8dp"
            android:text="Cancel"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>