<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:fitsSystemWindows="true"
    android:background="?attr/selectableItemBackground">

    <!-- Small circular clock icon or state icon -->
    <ImageView
        android:id="@+id/history_item_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_settings"
        app:tint="@color/gray_dark"
        android:layout_marginEnd="16dp"
        android:contentDescription="Deliver timeline icon marker" />

    <!-- Date (01 Jun 2026) -->
    <TextView
        android:id="@+id/history_item_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:text="01 Jun 2026"
        android:textColor="@color/on_surface"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textStyle="bold" />

    <!-- Status String (Delivered [green] / Pending [red]) -->
    <TextView
        android:id="@+id/history_item_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Delivered"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textStyle="bold"
        android:textColor="@color/delivered_green" />

    <!-- Completed Timestamp (07:45 AM or empty) -->
    <TextView
        android:id="@+id/history_item_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="07:45 AM"
        android:textColor="@color/on_surface_variant"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

</LinearLayout>
