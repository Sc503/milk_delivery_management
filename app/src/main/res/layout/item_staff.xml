<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Number, Image, Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Serial Number with Badge -->
            <TextView
                android:id="@+id/txtNumber"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="@drawable/bg_number_badge" />

            <!-- Profile Image with Border -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imgStaff"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_person"
                android:layout_marginStart="12dp"
                app:civ_border_width="2dp"
                app:civ_border_color="@color/primary" />

            <!-- Name and Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tvStaffName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Staff Name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A2332" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvStaffMobile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 9876543210"
                        android:textSize="13sp"
                        android:textColor="#7B8794" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/bg_dot"
                        android:layout_gravity="center_vertical" />

                    <TextView
                        android:id="@+id/tvStaffId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID: 1"
                        android:textSize="12sp"
                        android:textColor="#94A3B8" />

                </LinearLayout>

                <!-- Status Badge -->
                <TextView
                    android:id="@+id/tvStaffStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active"
                    android:textSize="11sp"
                    android:textColor="#10B981"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_status_active" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8EDF2"
            android:layout_marginVertical="12dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Call Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="📞 Call"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#10B981"
                app:cornerRadius="10dp"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>