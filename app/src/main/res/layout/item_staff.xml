<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Main Content Row: Number + Image + Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Number Badge -->
            <TextView
                android:id="@+id/txtNumber"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="@drawable/bg_number_badge" />

            <!-- Profile Image -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imgStaff"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_person"
                android:layout_marginStart="10dp"
                app:civ_border_width="2dp"
                app:civ_border_color="@color/primary" />

            <!-- Staff Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <!-- Name + Status Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvStaffName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Staff Name"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A2332"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvStaffStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active"
                        android:textSize="10sp"
                        android:textColor="#10B981"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_status_active" />

                </LinearLayout>

                <!-- Mobile -->
                <TextView
                    android:id="@+id/tvStaffMobile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 9876543210"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="2dp" />

                <!-- Password -->
                <TextView
                    android:id="@+id/tvStaffPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔑 123456"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="1dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8EDF2"
            android:layout_marginVertical="10dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <!-- Edit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="✏️ Edit"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#3B82F6"
                app:cornerRadius="8dp"
                style="@style/Widget.MaterialComponents.Button" />

            <!-- Call Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="📞 Call"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#10B981"
                app:cornerRadius="8dp"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>