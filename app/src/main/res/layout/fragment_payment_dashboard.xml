<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Total Collection Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txtCollection"
                android:padding="16dp"
                android:textSize="22sp"
                android:textStyle="bold"
                android:text="₹0 Total Collection"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtCustomers"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Customers: 0"
                android:padding="12dp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtPaid"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Paid: 0"
                android:padding="12dp"/>

            <TextView
                android:id="@+id/txtPending"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Pending: 0"
                android:padding="12dp"/>
        </LinearLayout>

        <!-- PIE CHART -->
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieChart"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="16dp"/>

        <!-- STEP 9.18.10 — EXPORT EXCEL BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportExcel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EXPORT EXCEL"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</ScrollView>