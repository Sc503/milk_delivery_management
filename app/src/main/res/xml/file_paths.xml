<?xml version="1.0" encoding="utf-8"?>
<paths>

    <!-- App-specific external storage (Android/data/com.example.package/files) -->
    <external-files-path
        name="my_files"
        path="."/>

    <!-- Public external storage (e.g., /storage/emulated/0) -->
    <external-path
        name="external_files"
        path="."/>

    <!-- Specifically for Downloads folder -->
    <external-path
        name="downloads"
        path="Download"/>

    <!-- App-specific cache storage -->
    <cache-path
        name="cache_files"
        path="."/>

    <!-- App-specific external cache storage -->
    <external-cache-path
        name="external_cache"
        path="."/>

</paths>