<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/background">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_location"
        app:tint="@color/primary"
        android:layout_marginBottom="16dp"
        android:contentDescription="Milk Delivery app icon" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Milk Delivery Management App"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version 1.0.0 (Production)"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/gray_dark"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/white">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="This is a commercial-grade, offline-first Milk Distribution &amp; Customer Relationship application built to power local supply networks. It features exact route marking via Google Maps coordinate indexing, daily pending marker list updates, calendar activity grids, and automated monthly analytics dashboards."
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/on_surface_variant"
            android:lineSpacingExtra="4dp" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
