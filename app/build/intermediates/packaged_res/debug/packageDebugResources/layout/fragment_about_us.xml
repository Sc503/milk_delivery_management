<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp"
    android:gravity="center">

    <!-- App Icon -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_location"
        app:tint="@color/primary"
        android:layout_marginBottom="12dp"
        android:contentDescription="Milk Delivery app icon" />

    <!-- App Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Milk Flow"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="2dp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Milk Delivery Management System"
        android:textSize="13sp"
        android:textColor="#6B7280"
        android:layout_marginBottom="2dp" />

    <!-- Version -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version 1.0.0"
        android:textSize="11sp"
        android:textColor="#94A3B8"
        android:layout_marginBottom="16dp" />

    <!-- Divider -->
    <View
        android:layout_width="50dp"
        android:layout_height="3dp"
        android:background="@color/primary"
        android:layout_marginBottom="16dp" />

    <!-- About Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section: About -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥛 About Us"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1A2332"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your reliable partner for fresh and timely milk delivery management."
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <!-- Section: Mission -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 Our Mission"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A2332"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="To simplify daily milk distribution by connecting customers, delivery staff, and suppliers through a smart, efficient, and transparent platform."
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginVertical="6dp" />

            <!-- Section: Features -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ What You Can Do"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A2332"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ Manage daily milk subscriptions"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:paddingVertical="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ Track deliveries in real-time"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:paddingVertical="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ View payment and order history"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:paddingVertical="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ Transparent communication with service providers"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:paddingVertical="2dp"
                android:layout_marginBottom="8dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginVertical="6dp" />

            <!-- Section: Team -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👨‍💻 Developed By"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A2332"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Saurabh Chaudhari &amp; Karan Pawar"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="4dp" />

            <!-- Thank You -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🙏 Thank you for trusting us!"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:paddingTop="8dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>